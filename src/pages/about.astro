---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import ServicesStrip from '../components/ServicesStrip.astro';
---

<BaseLayout
  title="About — Mentora Group"
  description="Mentora Group is the parent company of HLB Ireland, an audit, accounting and tax advisory firm, and FutureRange, an IT services firm — one group, two independent firms."
>
  <!-- Page hero -->
  <section class="page-hero on-dark">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">About Mentora</p>
        <h1>The group behind the firms<span class="dot">.</span></h1>
        <p class="lede">
          One group, two independent firms, every discipline an ambitious
          business needs — that is Mentora Group.
        </p>
      </div>
      <div class="hero-media">
        <Placeholder name="about-hero" label="Insert image" ratio="4 / 3" dark />
      </div>
    </div>
  </section>

  <!-- Service strip (marquee) -->
  <ServicesStrip />

  <!-- Story -->
  <section class="story">
    <div class="container story-grid">
      <div data-reveal>
        <p class="eyebrow">Our story</p>
        <h2 class="section-title title-accent">What does Mentora Group stand for?</h2>
        <div class="body">
          <p>
            Mentora captures something more than guidance: it speaks to the
            quality of thinking we bring to every client relationship.
          </p>
          <p>
            Mentora Group stands for integrated, expert professional services
            delivered with personal commitment. We are the parent of HLB
            Ireland and FutureRange — together covering the full spectrum of
            professional services that privately owned businesses and private
            clients need to protect what they have built, navigate what is
            changing, and grow with confidence.
          </p>
          <p>
            We are ambitious, and we are built for the businesses and
            individuals who are the backbone of this island's economy.
          </p>
        </div>
      </div>
      <div class="story-media" data-reveal>
        <Placeholder name="about-story" label="Insert image" ratio="3 / 4" />
      </div>
    </div>
  </section>

  <!-- Purpose -->
  <section class="purpose band on-dark">
    <div class="container purpose-grid">
      <div data-reveal>
        <p class="eyebrow">Our purpose</p>
        <h2 class="purpose-lede">
          Privately owned businesses and private clients on the island of
          Ireland face a world that is more complex, more connected, and more
          exposed than ever before.
        </h2>
        <div class="purpose-body">
          <p>
            Mentora Group was built to help clients adapt to that complexity.
            By bringing together accounting, taxation, advisory, technology,
            managed IT, cybersecurity, and AI under one roof, we give our
            clients something rare: integrated expertise from people who
            understand their business, not just one corner of it.
          </p>
          <p class="purpose-close">
            We are ambitious for the businesses and individuals we serve.
          </p>
        </div>
      </div>
      <aside class="purpose-roof" data-reveal aria-label="Services across the group">
        <p class="roof-label">Under one roof</p>
        <p class="roof-firm hlb">HLB Ireland</p>
        <ul class="roof-list hlb">
          <li><a href="https://www.hlb.ie/services/audit-assurance/" target="_blank" rel="noopener noreferrer">Audit &amp; Assurance <span class="go" aria-hidden="true">↗</span></a></li>
          <li><a href="https://www.hlb.ie/services/taxation/" target="_blank" rel="noopener noreferrer">Taxation <span class="go" aria-hidden="true">↗</span></a></li>
          <li><a href="https://www.hlb.ie/services/business-advisory/" target="_blank" rel="noopener noreferrer">Business Advisory <span class="go" aria-hidden="true">↗</span></a></li>
          <li><a href="https://www.hlb.ie/services/corporate-finance-2/" target="_blank" rel="noopener noreferrer">Corporate Finance <span class="go" aria-hidden="true">↗</span></a></li>
        </ul>
        <p class="roof-firm fr">FutureRange</p>
        <ul class="roof-list fr">
          <li><a href="https://futurerange.ie/services/managed-services/" target="_blank" rel="noopener noreferrer">Modern Workplace &amp; Productivity <span class="go" aria-hidden="true">↗</span></a></li>
          <li><a href="https://futurerange.ie/services/security/" target="_blank" rel="noopener noreferrer">Cyber Security <span class="go" aria-hidden="true">↗</span></a></li>
          <li><a href="https://futurerange.ie/services/future-innovation/" target="_blank" rel="noopener noreferrer">Cloud, AI &amp; Transformation <span class="go" aria-hidden="true">↗</span></a></li>
          <li><a href="https://futurerange.ie/service-catalogue/" target="_blank" rel="noopener noreferrer">IT Service Catalogue <span class="go" aria-hidden="true">↗</span></a></li>
        </ul>
      </aside>
    </div>
  </section>

</BaseLayout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  h1 .dot { color: var(--gold); }

  .story { padding: 110px 0; }
  .story-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 80px;
    align-items: start;
  }
  .story h2 { margin-bottom: 26px; }
  .story .body p { max-width: 62ch; }
  .story .body p + p { margin-top: 18px; }
  .story .body a {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .story .body a:hover { color: var(--gold-deep); }

  /* purpose — statement left, "one roof" panel right */
  .purpose { padding: 104px 0 110px; position: relative; overflow: hidden; }
  .purpose::before {
    content: "";
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(640px 400px at 88% 12%, rgba(234, 182, 51, 0.13), transparent 62%),
      radial-gradient(700px 460px at 4% 96%, rgba(59, 191, 208, 0.14), transparent 62%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .purpose::before { animation: page-aurora 18s ease-in-out infinite alternate; }
  }
  .purpose::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(70% 90% at 85% 40%, black, transparent 75%);
    pointer-events: none;
  }
  .purpose-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 76px;
    align-items: center;
  }
  .purpose-lede {
    font-family: var(--font-serif);
    font-weight: 460;
    font-size: clamp(1.55rem, 3vw, 2.45rem);
    line-height: 1.38;
    letter-spacing: 0;
    color: #f0f4f5;
    max-width: 26ch;
    text-wrap: balance;
  }
  .purpose-body { margin-top: 30px; max-width: 56ch; }
  .purpose-body p { color: var(--text-on-dark); }
  .purpose-body p.purpose-close {
    margin-top: 20px;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--gold);
  }
  .purpose-roof {
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius-lg);
    padding: 32px 34px 18px;
    box-shadow: 0 24px 50px rgba(0, 10, 14, 0.25);
  }
  .roof-label {
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin-bottom: 10px;
  }
  .roof-firm {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 18px 0 2px;
  }
  .roof-firm.hlb { color: var(--gold); }
  .roof-firm.fr { color: var(--teal-bright); }
  .roof-firm:first-of-type { margin-top: 8px; }

  .roof-list { list-style: none; margin: 0; padding: 0; }
  .roof-list li { border-bottom: 1px solid var(--line); }
  .roof-list li:last-child { border-bottom: none; }
  .roof-list a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 2px;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--head);
    text-decoration: none;
  }
  .roof-list a::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .roof-list.hlb a::before { background: var(--gold); }
  .roof-list.fr a::before { background: var(--teal-bright); }
  .roof-list .go {
    margin-left: auto;
    font-weight: 800;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .roof-list.hlb .go { color: var(--gold); }
  .roof-list.fr .go { color: var(--teal-bright); }
  .roof-list.hlb a:hover { color: var(--gold); }
  .roof-list.fr a:hover { color: var(--teal-bright); }
  .roof-list a:hover .go,
  .roof-list a:focus-visible .go { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .hero-grid, .story-grid { grid-template-columns: 1fr; }
    .purpose-grid { grid-template-columns: 1fr; gap: 44px; }
  }
</style>
