---
import { href } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import ServicesStrip from '../components/ServicesStrip.astro';
---

<BaseLayout
  title="Careers — Mentora Group"
  description="Build your career with Mentora Group — 200+ professionals across HLB Ireland (accounting, assurance, tax, advisory, corporate finance and outsourcing & payroll) and FutureRange (IT services), with offices in Dublin, Belfast, Limerick and Cork."
>
  <!-- Page hero -->
  <section class="page-hero on-dark">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Careers</p>
        <h1>Build your career with the group<span class="dot">.</span></h1>
        <p class="lede">
          Mentora Group is 200+ professionals across two firms — accountants,
          tax specialists and advisors at HLB Ireland; engineers, consultants
          and security experts at FutureRange — with offices in Dublin,
          Belfast, Limerick and Cork.
        </p>
      </div>
      <div class="hero-media">
        <Placeholder name="careers-hero" label="Insert image" ratio="4 / 3" dark />
      </div>
    </div>
  </section>

  <!-- Service strip (marquee) -->
  <ServicesStrip />

  <!-- Open roles by firm -->
  <section class="hiring">
    <div class="container">
      <div class="hiring-head" data-reveal>
        <div>
          <p class="eyebrow">Open roles</p>
          <h2 class="section-title title-accent">Choose your side of the house.</h2>
        </div>
        <div class="hiring-copy">
          <p>
            Each firm hires directly — browse current openings, from graduate
            programmes to senior roles, on the firm's own careers page.
            Group-level roles at Mentora are advertised through the HLB
            Ireland jobs board.
          </p>
        </div>
      </div>
      <div class="firm-cards">
        <a class="firm" href="https://www.hlb.ie/careers/" target="_blank" rel="noopener noreferrer" data-reveal>
          <Placeholder name="firm-hlb" label="Insert image" ratio="16 / 9" />
          <span class="firm-body">
            <span class="tag">Accounting, Assurance, Tax, Advisory, Corporate Finance and Outsourcing &amp; Payroll</span>
            <span class="name">Careers at HLB Ireland <span class="go" aria-hidden="true">↗</span></span>
            <span class="desc">
              Roles across accounting, assurance, tax, advisory, corporate finance and outsourcing &amp; payroll — plus a graduate and internship programme with
              full ACA, ACCA or CPA support.
            </span>
          </span>
        </a>
        <a class="firm firm-teal" href="https://futurerange.ie/careers/" target="_blank" rel="noopener noreferrer" data-reveal>
          <Placeholder name="firm-futurerange" label="Insert image" ratio="16 / 9" />
          <span class="firm-body">
            <span class="tag">Managed IT, Security &amp; Digital</span>
            <span class="name">Careers at FutureRange <span class="go" aria-hidden="true">↗</span></span>
            <span class="desc">
              Engineers, consultants and commercial roles across managed
              services, cyber security, cloud and AI — in Dublin, Belfast,
              Limerick and Cork.
            </span>
          </span>
        </a>
        <a class="firm" href={href('/careers/mentora/')} data-reveal>
          <Placeholder name="firm-mentora" label="Insert image" ratio="16 / 9" />
          <span class="firm-body">
            <span class="tag">Group Functions</span>
            <span class="name">Careers at Mentora <span class="go" aria-hidden="true">→</span></span>
            <span class="desc">
              Group-level roles in finance, people and operations that
              support both firms — see the current group openings.
            </span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Speculative applications -->
  <section class="spec band on-dark">
    <div class="container spec-inner">
      <div data-reveal>
        <p class="eyebrow">Not seeing your role?</p>
        <h2>Good people are always worth a conversation.</h2>
        <p class="spec-body">
          Both firms welcome speculative applications. Send a CV to the team
          you'd like to join and tell us what you're great at.
        </p>
      </div>
      <div class="spec-actions" data-reveal>
        <a class="btn btn-gold" href="mailto:recruitment@hlb.ie">HLB Ireland — recruitment@hlb.ie</a>
        <a class="btn btn-ghost" href="mailto:careers@futurerange.ie">FutureRange — careers@futurerange.ie</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 .dot { color: var(--gold); }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }

  /* firm hiring cards — same card language as the homepage */
  .hiring { padding: 100px 0 110px; }
  .hiring-head {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
    margin-bottom: 46px;
  }
  .hiring-head h2 { margin-bottom: 0; }
  .hiring-copy p { max-width: 52ch; }
  .firm-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .firm {
    display: block;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--gold);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .firm :global(.ph), .firm :global(.slot) { border-radius: 0; border-left: none; border-right: none; border-top: none; }
  @media (prefers-reduced-motion: no-preference) {
    .firm:hover {
      transform: translateY(-5px);
      box-shadow: 0 22px 48px rgba(26, 41, 48, 0.16), 0 0 0 1px rgba(234, 182, 51, 0.55);
    }
  }
  .firm-body { display: block; padding: 28px 30px 32px; }
  .firm .tag {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--gold-deep);
    display: block;
    margin-bottom: 10px;
  }
  .firm .name {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--head);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .firm .go {
    font-size: 1.2rem;
    font-weight: 400;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    border-radius: 999px;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    flex: none;
  }
  .firm:hover .go {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
  }
  .firm-teal { border-top-color: var(--teal-bright); }
  .firm-teal .tag { color: var(--teal-ink); }
  @media (prefers-reduced-motion: no-preference) {
    .firm-teal:hover {
      box-shadow: 0 22px 48px rgba(26, 41, 48, 0.16), 0 0 0 1px rgba(59, 191, 208, 0.6);
    }
  }
  .firm-teal:hover .go {
    background: var(--teal-bright);
    border-color: var(--teal-bright);
    color: #06272c;
  }
  .firm .desc {
    display: block;
    color: var(--body);
    font-size: 0.95rem;
    margin-top: 10px;
    max-width: 46ch;
  }

  /* speculative applications band */
  .spec { padding: 100px 0; position: relative; overflow: hidden; }
  .spec::before {
    content: "";
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(600px 400px at 88% 12%, rgba(234, 182, 51, 0.14), transparent 60%),
      radial-gradient(640px 420px at 6% 90%, rgba(59, 191, 208, 0.16), transparent 62%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .spec::before { animation: page-aurora 17s ease-in-out infinite alternate; }
  }
  .spec-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
  }
  .spec h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    font-weight: 480;
    color: #f0f4f5;
    margin-bottom: 16px;
    max-width: 22ch;
    text-wrap: balance;
  }
  .spec-body { color: var(--text-on-dark); max-width: 50ch; }
  .spec-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .hiring-head { grid-template-columns: 1fr; gap: 18px; }
    .firm-cards { grid-template-columns: 1fr; }
    .spec-inner { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
