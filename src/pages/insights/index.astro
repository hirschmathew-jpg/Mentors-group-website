---
import { href } from '../../lib/paths';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/Cta.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ServicesStrip from '../../components/ServicesStrip.astro';

const firmOf = (id: string) => (/futurerange|future-range/i.test(id) ? 'FutureRange' : 'HLB Ireland');
const all = (await getCollection('insights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const toCard = (p: (typeof all)[number]) => ({
  title: p.data.title,
  description: p.data.description,
  date: p.data.date.toISOString().slice(0, 10),
  firm: firmOf(p.id) as 'HLB Ireland' | 'FutureRange',
  url: href(`/insights/${p.id}/`),
  image: `insight-${p.id}`,
});
const hlb = all.filter((p) => firmOf(p.id) === 'HLB Ireland').map(toCard);
const fr = all.filter((p) => firmOf(p.id) === 'FutureRange').map(toCard);
---

<BaseLayout
  title="Insights — Mentora Group"
  description="Insights, commentary and updates from across the Mentora Group — practical guidance on advisory, technology and cybersecurity for Irish businesses."
>
  <section class="page-hero on-dark">
    <div class="container">
      <p class="eyebrow">Insights</p>
      <h1>Commentary and updates from across the group</h1>
      <p class="lede">
        Thought leadership, practical guidance and expert perspectives — what's
        happening, what it means for your business, and what to do next.
      </p>
    </div>
  </section>

  <!-- Service strip (marquee) -->
  <ServicesStrip />

  <section class="listing" aria-label="Articles">
    <div class="container">
      <div class="cols">
        <div class="col" data-col>
          <h2 class="col-head hlb">HLB Ireland <span class="count">{hlb.length} articles</span></h2>
          <div class="col-stack">
            {hlb.map((a) => (
              <ArticleCard
                title={a.title}
                description={a.description}
                date={a.date}
                firm={a.firm}
                url={a.url}
                internal={true}
                image={a.image}
              />
            ))}
          </div>
          <div class="more-wrap">
            <button class="btn btn-more" type="button" data-show-more aria-expanded="false">
              Show more articles
            </button>
          </div>
        </div>

        <div class="col" data-col>
          <h2 class="col-head fr">FutureRange <span class="count">{fr.length} articles</span></h2>
          <div class="col-stack">
            {fr.map((a) => (
              <ArticleCard
                title={a.title}
                description={a.description}
                date={a.date}
                firm={a.firm}
                url={a.url}
                internal={true}
                image={a.image}
              />
            ))}
          </div>
          <div class="more-wrap">
            <button class="btn btn-more" type="button" data-show-more aria-expanded="false">
              Show more articles
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .listing { padding: 90px 0 110px; }

  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    font-size: 1.15rem;
    color: var(--head);
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--line);
  }
  .col-head.hlb { border-bottom-color: var(--gold); }
  .col-head.fr { border-bottom-color: var(--teal, #3bbfd0); }
  .count {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .col-stack {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .more-wrap { display: flex; justify-content: center; margin-top: 36px; }
  .btn-more {
    background: transparent;
    color: var(--head);
    border: 1px solid var(--line);
    cursor: pointer;
  }
  .btn-more:hover { border-color: var(--gold); color: var(--gold); }
  /* Without JS the toggles can't run, so just show everything. */
  :global(html:not(.js)) .more-wrap { display: none; }

  @media (max-width: 960px) {
    .cols { grid-template-columns: 1fr; gap: 64px; }
  }
</style>

<script>
  // Each firm column reveals six articles at a time; once everything is
  // visible the button collapses the column back down.
  const STEP = 6;
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-col]').forEach((col) => {
      if ((col as any).__moreBound) return;
      (col as any).__moreBound = true;

      const btn = col.querySelector<HTMLButtonElement>('[data-show-more]');
      const cards = [...col.querySelectorAll<HTMLElement>('.col-stack > .acard')];
      if (!btn) return;
      if (cards.length <= STEP) {
        btn.closest<HTMLElement>('.more-wrap')?.remove();
        return;
      }

      let shown = STEP;
      const render = () => {
        // inline display beats the card's own `display:flex`, which would
        // otherwise override the [hidden] attribute.
        cards.forEach((c, i) => (c.style.display = i < shown ? '' : 'none'));
        btn.textContent = shown >= cards.length ? 'Show fewer articles' : 'Show more articles';
        btn.setAttribute('aria-expanded', shown > STEP ? 'true' : 'false');
      };
      render();

      btn.addEventListener('click', () => {
        if (shown >= cards.length) {
          shown = STEP;
          render();
          col.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          shown = Math.min(shown + STEP, cards.length);
          render();
        }
      });
    });
  });
</script>
